---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { preGitHubProjects, sideProjects, workProjects } from '../data/projects';
---

<BaseLayout title="Projects — Christopher Schleiden" description="Work projects, side projects, experiments, and open source tools.">
  <section class="section" style="padding-top: 76px;">
    <div class="container">
      <div class="section-header fade-up">
        <span class="section-title">Projects</span>
      </div>

      <h3 class="fade-up" style="color: var(--text-primary); margin-bottom: 16px; font-size: 1.1rem; font-weight: 600;">Work</h3>
      <p class="fade-up" style="color: var(--text-secondary); margin-bottom: 32px;">
        A few of the products I've helped build at GitHub.
      </p>
      <div class="projects-grid stagger" style="margin-bottom: 60px;">
        {workProjects.map(project => (
          <ProjectCard project={project} />
        ))}
      </div>

      <h4 class="fade-up" style="color: var(--text-muted); margin-bottom: 16px; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em;">Other</h4>
      <div class="projects-grid stagger" style="margin-bottom: 60px;">
        {preGitHubProjects.map(project => (
          <ProjectCard project={project} />
        ))}
      </div>

      <h3 class="fade-up" style="color: var(--text-primary); margin-bottom: 16px; font-size: 1.1rem; font-weight: 600;">Side projects</h3>
      <p class="fade-up" style="color: var(--text-secondary); margin-bottom: 32px;">
        Some of my side-projects. Some are random experiments, others are "work-adjacent" explorations or extensions, and some are just for fun.
      </p>
      <div class="projects-grid stagger">
        {sideProjects.map(project => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
