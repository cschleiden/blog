---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { featuredSideProjects, workProjects } from '../data/projects';
import { getCollection } from 'astro:content';

function splitLetters(word: string) {
  return word.split('');
}

const heroWords = ['Christopher', 'Schleiden'];

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
}

function getSlug(id: string) {
  return id.replace(/\.mdx?$/, '');
}
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-line"></div>
      <h1 aria-label={heroWords.join(' ')}>
        {heroWords.map((word, wi) => (
          <>
            <span class="hero-word-mask">
              <span class="hero-word" data-text={word} style={`--glitch-base:${0.15 + wi * 0.12}s`}>
                {splitLetters(word).map((ch, li) => (
                  <span class="hero-letter" style={`--i:${li}; --base:${0.25 + wi * 0.18}s`} aria-hidden="true">{ch}</span>
                ))}
              </span>
            </span>
            {wi === 0 && <br/>}
          </>
        ))}
      </h1>
      <p class="hero-description">
        Software engineer at GitHub, working on <span class="hero-keyword"><span class="hero-keyword-inner" id="heroKeyword">agentic coding tools</span></span>.<br/>
        Originally from Cologne, now in the Pacific Northwest. When not coding, probably on a mountain somewhere.
      </p>

    </div>
  </section>

  <!-- Writing -->
  <section class="section" id="writing">
    <div class="container">
      <div class="section-header fade-up">
        <span class="section-title">Writing</span>
        <a href="/blog" class="section-link">All posts →</a>
      </div>
      <div class="post-list stagger">
        {posts.map(post => (
          <a href={`/blog/${getSlug(post.id)}`} class="post-item">
            <span class="post-date">{formatDate(post.data.date)}</span>
            <span class="post-title-text">{post.data.title}</span>
            {post.data.tags[0] && <span class="post-tag">{post.data.tags[0]}</span>}
            <span class="post-arrow">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="container"><div class="divider"></div></div>

  <!-- Projects -->
  <section class="section" id="projects">
    <div class="container">
      <div class="section-header fade-up">
        <span class="section-title">Projects</span>
        <a href="/projects" class="section-link">View all →</a>
      </div>

      <h3 class="fade-up" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 16px;">Work</h3>
      <div class="projects-grid stagger" style="margin-bottom: 40px;">
        {workProjects.map(project => (
          <ProjectCard project={project} />
        ))}
      </div>

      <h3 class="fade-up" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 16px;">Side projects</h3>
      <div class="projects-grid stagger">
        {featuredSideProjects.map(project => (
          <ProjectCard project={project} countStars showImage={false} />
        ))}
      </div>
    </div>
  </section>

  <div class="container"><div class="divider"></div></div>

  <!-- About -->
  <section class="section" id="about">
    <div class="container">
      <div class="section-header fade-up">
        <span class="section-title">About</span>
        <a href="/about" class="section-link">More →</a>
      </div>
      <div class="about-content">
        <p class="about-intro fade-up">
          I'm a <span class="highlight">Staff Software Engineer</span> at GitHub,
          where I'm working on the <a href="https://github.com/features/ai/github-app">GitHub Copilot app</a>. I care deeply about
          developer experience and building tools that get out of your way.
          Originally from <span class="highlight">Cologne</span>, now somewhere
          in the PNW chasing summit views.
        </p>

        <div class="journey stagger">
          <div class="journey-item current fade-up">
            <div class="journey-dot"></div>
            <div class="journey-period">2019 → now</div>
            <div class="journey-role">Staff Software Engineer</div>
            <div class="journey-place">GitHub · Copilot</div>
            <div class="journey-note">Currently working on the <a href="https://github.com/features/ai/github-app">GitHub Copilot app</a>. Helped launch and scale GitHub Actions, worked on GitHub Models, and contributed to GitHub Copilot cloud agent.</div>
          </div>
          <div class="journey-item fade-up">
            <div class="journey-dot"></div>
            <div class="journey-period">2011 → 2019</div>
            <div class="journey-role">Consultant → Principal Engineering Manager</div>
            <div class="journey-place">Microsoft · Cologne, Germany → Redmond, US</div>
          </div>
          <div class="journey-item fade-up">
            <div class="journey-dot"></div>
            <div class="journey-period">2007 → 2011</div>
            <div class="journey-role">B.Sc./M.Sc. Computer Science</div>
            <div class="journey-place">RWTH Aachen University · Germany</div>
          </div>
        </div>


      </div>
    </div>
  </section>

  <script>
    // Rotating keyword
    (function() {
      const words = ['coding agents', 'agentic coding tools', 'CI/CD at scale', 'open source'];
      const el = document.getElementById('heroKeyword');
      if (!el) return;
      let idx = 0;
      setInterval(() => {
        el.classList.add('swap-out');
        setTimeout(() => {
          idx = (idx + 1) % words.length;
          el.textContent = words[idx];
          el.classList.remove('swap-out');
          el.classList.add('swap-in');
          requestAnimationFrame(() => requestAnimationFrame(() => el.classList.remove('swap-in')));
        }, 300);
      }, 2800);
    })();

    // Counter animation
    const counterObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const target = entry.target as HTMLElement;
        if (entry.isIntersecting && !target.dataset.counted) {
          target.dataset.counted = 'true';
          const end = parseInt(target.dataset.target || '0', 10);
          const duration = 1200;
          const start = performance.now();
          function tick(now: number) {
            const progress = Math.min((now - start) / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            target.textContent = String(Math.floor(eased * end));
            if (progress < 1) requestAnimationFrame(tick);
            else target.textContent = String(end);
          }
          requestAnimationFrame(tick);
        }
      });
    }, { threshold: 0.5 });
    document.querySelectorAll('.count-up').forEach(el => counterObserver.observe(el));

    // Project card tilt
    document.querySelectorAll('.project-card').forEach(card => {
      const el = card as HTMLElement;
      el.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = el.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        el.style.transform = `translateY(-2px) rotateY(${x * 6}deg) rotateX(${-y * 6}deg)`;
      });
      el.addEventListener('mouseleave', () => {
        el.style.transform = 'translateY(0) rotateY(0) rotateX(0)';
        el.style.transition = 'transform 0.4s ease, border-color 0.25s, box-shadow 0.25s';
      });
      el.addEventListener('mouseenter', () => {
        el.style.transition = 'border-color 0.25s, box-shadow 0.25s';
      });
    });
  </script>
</BaseLayout>
